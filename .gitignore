tmp/
temp/

# data/ はブランチ claude/google-drive-07-02-search-orep5y が管理する元データ。
# analysis用ブランチではローカルの作業ツリーに一時的に取り込んで分析にのみ使用し、
# 重複コミットを避けるためこのブランチでは追跡しない。
data/
